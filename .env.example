# Set ONE of these to get AI-written answers. With neither, the app runs in
# extractive mode (returns the best matching sentences from your docs).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Used for semantic search when OPENAI_API_KEY is set
EMBEDDING_MODEL=text-embedding-3-small
# Folder the assistant indexes on startup
DOCS_DIR=sample_docs
